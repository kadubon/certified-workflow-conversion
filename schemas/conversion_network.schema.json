{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwc:schema:conversion-network:0.1",
  "type": "object",
  "required": ["name", "nodes", "edges"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "source_nodes": {"type": "array", "items": {"type": "string"}},
    "sink_nodes": {"type": "array", "items": {"type": "string"}},
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "from_node", "to_node", "capacity"],
        "properties": {
          "name": {"type": "string"},
          "from_node": {"type": "string"},
          "to_node": {"type": "string"},
          "capacity": {"type": "integer", "minimum": 0},
          "cost_per_unit": {"type": "integer", "minimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
