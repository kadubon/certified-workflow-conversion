{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwc:schema:claim-requirement:0.1",
  "type": "object",
  "required": ["network_id", "target_value"],
  "properties": {
    "network_id": {"type": "string", "pattern": "^net_"},
    "target_value": {"type": "integer", "minimum": 0},
    "required_scopes": {"type": "array", "items": {"type": "string"}},
    "required_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "required_tcb": {"type": "array", "items": {"type": "string"}},
    "certification_split": {"type": "object"}
  }
}

